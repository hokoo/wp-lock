{
    "name": "hokoo/wp-lock",
    "description": "A library for locking and mutexes for the WordPress Core",
    "license": "MIT",
    "homepage": "https://github.com/hokoo/wp-lock",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "lib/install.php",
            "lib/class-wp-lock.php",
            "lib/helpers/Database.php",
            "lib/backend/class-wp-lock-backend.php",
            "lib/backend/class-wp-lock-backend-db.php",
            "lib/backend/class-wp-lock-foundations.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^4.0",
        "wp-coding-standards/wpcs": "^3.4",
        "phpstan/phpstan": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-filter lib --coverage-clover build/logs/clover.xml",
        "lint": "@php vendor/bin/phpcs --standard=phpcs.xml.dist",
        "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --debug"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
