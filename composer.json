{
    "name": "hokoo/wp-lock",
    "description": "A library for locking and mutexes for the WordPress Core",
    "license": "MIT",
    "homepage": "https://github.com/hokoo/wp-lock",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "files": [
            "lib/install.php",
            "lib/class-wp-lock.php",
            "lib/helpers/Database.php",
            "lib/backend/class-wp-lock-backend.php",
            "lib/backend/class-wp-lock-backend-db.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-filter lib --coverage-clover build/logs/clover.xml"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "johnpbloch/wordpress-core-installer": true
        }
    }
}
